# Salin menjadi .env lalu sesuaikan. Semua opsional.

PORT=3000
HOST=0.0.0.0
# Folder penyimpanan file terenkripsi
DATA_DIR=./data
# Batas total per kiriman (byte). 5368709120 = 5 GB
MAX_BYTES=5368709120
MAX_FILES=100
# Masa berlaku tautan (hari)
EXPIRY_DAYS=15
# Kiriman baru maksimal per IP per jam
RATE_LIMIT_PER_HOUR=30
# Isi 1 bila server berada di belakang Nginx/Cloudflare (membaca X-Forwarded-For)
TRUST_PROXY=0

# --- Kirim lewat email (opsional) ---
# Kosongkan SMTP_HOST untuk menonaktifkan fitur email.
SMTP_HOST=
SMTP_PORT=587
# 1 untuk port 465 (SSL langsung), 0 untuk 587 (STARTTLS)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KirimAman <noreply@domainanda.com>"
